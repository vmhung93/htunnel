# Copy to .env and fill in real values:  cp .env.example .env
# Load it with:  uv run --env-file .env python server.py
# On Render, set these in the service's Environment tab instead (Render sets PORT itself).

# Required. Comma-separated channel=token pairs; each person gets their own channel and token.
# Channel names: A-Z a-z 0-9 _ -   Tokens: unique per channel, no commas.
# Generate a token with:  openssl rand -hex 32
CHANNEL_TOKENS=user1=replace-with-a-long-random-token,user2=replace-with-another-long-random-token

# Optional (defaults shown)
# PORT=10000
# HEARTBEAT_INTERVAL=15
# MAX_BODY_BYTES=5242880
# LOG_LEVEL=INFO
