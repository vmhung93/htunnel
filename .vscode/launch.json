{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Runs server/server.py directly (its __main__ calls uvicorn.run)
            "name": "Server: server.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/server/server.py",
            "cwd": "${workspaceFolder}/server",
            "python": "${workspaceFolder}/server/.venv/bin/python",
            "envFile": "${workspaceFolder}/server/.env",
            "console": "integratedTerminal",
            "justMyCode": true,
            "presentation": { "group": "htunnel", "order": 1 }
        },
        {
            // Same server via uvicorn with auto-reload on code changes
            "name": "Server: uvicorn --reload",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "server:app",
                "--port",
                "10000",
                "--reload",
                "--timeout-graceful-shutdown",
                "5"
            ],
            "cwd": "${workspaceFolder}/server",
            "python": "${workspaceFolder}/server/.venv/bin/python",
            "envFile": "${workspaceFolder}/server/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            // Tunnel client; flags override values from client/.env
            "name": "Client: tunnel_client.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/client/tunnel_client.py",
            "args": [
                "--verbose"
            ],
            "cwd": "${workspaceFolder}/client",
            "python": "${workspaceFolder}/client/.venv/bin/python",
            "envFile": "${workspaceFolder}/client/.env",
            "console": "integratedTerminal",
            "justMyCode": true,
            "presentation": { "group": "htunnel", "order": 2 }
        }
    ],
    "compounds": [
        {
            "name": "Server + Client",
            "configurations": ["Server: server.py", "Client: tunnel_client.py"],
            "stopAll": true
        }
    ]
}
