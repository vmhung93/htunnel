# Copy to .env and fill in:  cp .env.example .env
# Run with:  uv run --env-file .env python tunnel_client.py

# Required. Relay server base URL.
HTUNNEL_REMOTE=https://your-relay.onrender.com
# Required. Your channel's token (one entry of the server's CHANNEL_TOKENS). Keep it secret.
HTUNNEL_TOKEN=replace-with-your-channel-token

# Optional (defaults shown)
# Local app: a port, or a full URL such as http://127.0.0.1:3000
# HTUNNEL_LOCAL=8080
# Seconds to wait for the local app
# HTUNNEL_LOCAL_TIMEOUT=30
# Max webhooks forwarded to the local app at once
# HTUNNEL_CONCURRENCY=10
